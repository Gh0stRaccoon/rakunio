---
import Layout from '../../layouts/Layout.astro';
import CanvasVisualizer from '../../components/CanvasVisualizer.astro';
import LrcLyrics from '../../components/LrcLyrics.astro';
import { ALBUMS } from '../../data/tracks';
import type { Track } from '../../types/track';
import { withBase } from '../../utils/base';

export function getStaticPaths() {
  return ALBUMS.map((album) => ({
    params: { id: album.id },
    props: { album, albumTracks: album.tracks }
  }));
}

const { album, albumTracks } = Astro.props;

const fallbackTrack: Track = {
  id: 'fallback',
  title: 'Sin título',
  artist: 'Rakun.io',
  album: 'rakunio',
  albumId: 'rakunio',
  duration: 150,
  cover: withBase('/favicon.svg'),
  audioUrl: ''
};

const defaultTrack: Track = albumTracks[0] || album.tracks[0] || fallbackTrack;

const albumSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  'name': album.title,
  'byArtist': { '@type': 'MusicGroup', 'name': album.artist },
  'image': album.cover,
  'datePublished': `${album.year}`,
  'description': album.description,
  'numTracks': album.tracks.length,
  'track': album.tracks.map(t => ({
    '@type': 'MusicRecording',
    'name': t.title,
    'byArtist': { '@type': 'MusicGroup', 'name': t.artist },
    'duration': `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`
  }))
};

// Calculate total duration in minutes
const totalSecs = albumTracks.reduce((acc, t) => acc + (t.duration || 150), 0);
const totalMins = Math.round(totalSecs / 60);
---

<Layout 
  title={`${album.title} — Carpeta / Álbum | Rakunio`} 
  description={album.description}
  image={album.cover}
  jsonLd={albumSchema}
>
  <!-- Main Racoon Player Workspace Shell -->
  <div class="player-main-workspace glass-panel">
    
    <!-- MODE 1: ALBUM HERO SHOWCASE -->
    <div class="album-hero-top" id="album-hero-section">
      <!-- Left: Album Portrait Card with Aura Glow -->
      <div class="album-hero-portrait-container">
        <div class="aura-glow"></div>
        <div class="album-hero-cover-card glass-panel">
          <img src={album.cover} alt={album.title} class="hero-cover-img" />
          <button id="btn-hero-play-overlay" class="hero-play-overlay-btn" title="Reproducir todo el álbum">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-play-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right: Album Meta Header & Dynamic Markdown Info -->
      <div class="album-hero-info">
        <div class="album-badge-row">
          <span class="category-badge">COLECCIÓN / ÁLBUM</span>
          <span class="album-year-badge">{album.year}</span>
        </div>

        <h1 class="album-hero-title">{album.title}</h1>
        <div class="album-hero-artist-row">
          <span class="hero-artist-name">{album.artist}</span>
          <span class="meta-dot">•</span>
          <span class="hero-meta-stat">{albumTracks.length} canciones</span>
          <span class="meta-dot">•</span>
          <span class="hero-meta-stat">{totalMins} min aprox.</span>
        </div>

        <!-- Dynamic Markdown Description Card -->
        <div class="album-markdown-card glass-panel">
          <div class="markdown-body">
            {album.description.split('\n').map((paragraph) => {
              if (paragraph.startsWith('# ')) {
                return <h2 class="md-h2">{paragraph.replace(/^#\s+/, '')}</h2>;
              } else if (paragraph.startsWith('## ')) {
                return <h3 class="md-h3">{paragraph.replace(/^##\s+/, '')}</h3>;
              } else if (paragraph.startsWith('- ')) {
                return <li class="md-li">{paragraph.replace(/^- /, '')}</li>;
              } else if (paragraph.trim().length > 0) {
                return <p class="md-p">{paragraph}</p>;
              }
              return null;
            })}
          </div>
        </div>

        <!-- Primary Action Buttons -->
        <div class="album-hero-actions">
          <button id="btn-hero-play-all" class="hero-primary-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
            <span>Reproducir Todo</span>
          </button>

          <button id="btn-hero-shuffle" class="hero-secondary-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <polyline points="16 3 21 3 21 8"/>
              <line x1="4" y1="20" x2="21" y2="3"/>
              <polyline points="21 16 21 21 16 21"/>
              <line x1="15" y1="15" x2="21" y2="21"/>
            </svg>
            <span>Aleatorio</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MODE 2: EXACT ORIGINAL 3D PLAYER LAYOUT (Revealed on Play) -->
    <div class="player-top-row hidden" id="album-player-section">
      <!-- Left Column: 5-Card Continuous 3D CoverFlow Stage + Visualizer + Controls -->
      <div class="player-left-col">
        <div class="stage-carousel-container">
          <!-- Continuous 5-Card 3D Cover Stage -->
          <div class="cover-stage" id="cover-stage">
            <!-- 5 Persistent Cards mapped dynamically by data-pos -->
            <div class="cover-card" data-card-slot="0" data-pos="-2">
              <img id="card-img-0" src={defaultTrack.cover} alt="Cover" class="card-img" />
            </div>

            <div class="cover-card" data-card-slot="1" data-pos="-1" title="Canción anterior">
              <img id="card-img-1" src={defaultTrack.cover} alt="Cover" class="card-img" />
              <div class="card-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
                  <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <div class="cover-card" data-card-slot="2" data-pos="0" id="cover-slide-container">
              <img id="card-img-2" src={defaultTrack.cover} alt="Cover" class="card-img main-img" />
            </div>

            <div class="cover-card" data-card-slot="3" data-pos="1" title="Siguiente canción">
              <img id="card-img-3" src={defaultTrack.cover} alt="Cover" class="card-img" />
              <div class="card-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
                  <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <div class="cover-card" data-card-slot="4" data-pos="2">
              <img id="card-img-4" src={defaultTrack.cover} alt="Cover" class="card-img" />
            </div>

            <!-- Free Spectrum Visualizer Overlay Centered Vertically Over Active Cover Card -->
            <div class="cover-visualizer-overlay" id="cover-visualizer-overlay">
              <CanvasVisualizer />
            </div>

            <!-- Fixed Center Active Mobile Lyrics Backdrop Overlay (Mobile Only) -->
            <div class="mobile-lyrics-overlay" id="mobile-lyrics-overlay">
              <div class="overlay-header">
                <span class="overlay-title">Letra</span>
                <button id="btn-close-lyrics-overlay" class="overlay-close-btn" title="Cerrar letra">✕</button>
              </div>
              <div class="overlay-lyrics-body">
                <LrcLyrics />
              </div>
            </div>
          </div>

          <!-- Mobile Lyrics Toggle Floating Action Button (Mobile Only) -->
          <button id="btn-toggle-lyrics-overlay" class="mobile-lyrics-toggle-btn" title="Ver letra sobre carátula">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lyrics-toggle-icon">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              <line x1="9" y1="9" x2="15" y2="9"/>
              <line x1="9" y1="13" x2="13" y2="13"/>
            </svg>
            <span class="lyrics-toggle-label">Ver Letra</span>
          </button>
        </div>

        <!-- Progress & Seek Bar -->
        <div class="progress-section">
          <span id="main-time-current" class="time-stamp">0:00</span>
          <div class="seek-bar-track" id="seek-bar">
            <div id="seek-fill" class="seek-bar-fill"></div>
          </div>
          <span id="main-time-duration" class="time-stamp">2:25</span>
        </div>

        <!-- Control Action Buttons -->
        <div class="controls-row">
          <button id="btn-shuffle" class="icon-btn" title="Modo Aleatorio">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
              <polyline points="16 3 21 3 21 8"/>
              <line x1="4" y1="20" x2="21" y2="3"/>
              <polyline points="21 16 21 21 16 21"/>
              <line x1="15" y1="15" x2="21" y2="21"/>
            </svg>
          </button>

          <button id="btn-prev-main" class="icon-btn" title="Anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
              <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"/>
              <line x1="5" y1="19" x2="5" y2="5" stroke-linecap="round"/>
            </svg>
          </button>

          <button id="btn-play-main" class="main-play-btn" title="Reproducir / Pausar">
            <svg id="icon-play-main" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="main-play-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
            <svg id="icon-pause-main" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="main-play-icon hidden">
              <rect x="6" y="4" width="4" height="16" fill="currentColor"/>
              <rect x="14" y="4" width="4" height="16" fill="currentColor"/>
            </svg>
          </button>

          <button id="btn-next-main" class="icon-btn" title="Siguiente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
              <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"/>
              <line x1="19" y1="5" x2="19" y2="19" stroke-linecap="round"/>
            </svg>
          </button>

          <button id="btn-repeat" class="icon-btn" title="Modo Repetir">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
              <polyline points="17 1 21 5 17 9"/>
              <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
              <polyline points="7 23 3 19 7 15"/>
              <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
            </svg>
          </button>
        </div>

        <!-- Volume Bar -->
        <div class="volume-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="vol-icon">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/>
          </svg>
          <input id="vol-range-main" type="range" min="0" max="1" step="0.01" value="0.8" class="vol-slider-main" />
        </div>
      </div>

      <!-- Right Column: Track Info + Synced Lyrics (Desktop) -->
      <div class="player-right-col">
        <div class="track-header-meta">
          <span id="main-category-badge" class="category-badge">{album.title.toUpperCase()}</span>
          <div class="title-like-row">
            <h1 id="main-track-title" class="track-title">{defaultTrack.title}</h1>
            
            <div class="header-action-group">
              <button id="btn-share-main" class="action-btn" title="Compartir canción">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-icon">
                  <circle cx="18" cy="5" r="3"/>
                  <circle cx="6" cy="12" r="3"/>
                  <circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
              </button>
              
              <button id="btn-like" class="like-btn" title="Favorito">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="like-icon">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
            </div>
          </div>
          <span id="main-artist-name" class="artist-name">{defaultTrack.artist}</span>
        </div>

        <!-- Synced Lyrics Component (Desktop Column) -->
        <div class="lyrics-wrapper-desktop">
          <LrcLyrics />
        </div>
      </div>
    </div>

    <!-- Bottom Playlist Section -->
    <div class="playlist-section">
      <div class="playlist-section-header">
        <div class="playlist-header-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="playlist-header-icon">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="quick-title">Lista de Canciones ({albumTracks.length})</span>
        </div>

        <button id="btn-toggle-playlist" class="playlist-toggle-btn" title="Mostrar / Ocultar lista">
          <span id="toggle-playlist-label">Ocultar lista</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toggle-icon">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </button>
      </div>

      <div class="playlist-vertical-list" id="playlist-container">
        {albumTracks.map((t, idx) => (
          <div class="playlist-track-row" data-track-id={t.id}>
            <span class="track-idx">{idx + 1}</span>
            <img src={t.cover} alt={t.title} class="playlist-thumb" data-audio-url={t.audioUrl} />
            <div class="playlist-track-meta" data-action="play">
              <span class="playlist-track-name">{t.title}</span>
              <span class="playlist-track-artist">{t.artist}</span>
            </div>
            <span class="playlist-track-album" data-action="play">{t.album}</span>
            <span class="playlist-track-duration">{t.duration || '2:30'}</span>
            <button class="row-share-btn" data-share-id={t.id} title="Copiar enlace de canción">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="row-share-icon">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div id="album-raw-tracks" data-tracks={JSON.stringify(albumTracks)} class="hidden"></div>
</Layout>

<script>
  import { AudioEngine } from '../../lib/audio/AudioEngine';
  import { 
    $currentTrack, 
    $isPlaying,
    $currentTime,
    $duration,
    $volume,
    $isShuffle,
    $repeatMode,
    playTrack,
    setQueue,
    togglePlay,
    toggleShuffle,
    cycleRepeatMode,
    setVolume
  } from '../../lib/audio/PlayerStore';

  let isMobileLyricsOverlayOpen = false;

  function formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function initAlbumHero() {
    AudioEngine.init();
    
    const rawContainer = document.getElementById('album-raw-tracks');
    let albumTracks: any[] = [];
    if (rawContainer) {
      try {
        albumTracks = JSON.parse(rawContainer.getAttribute('data-tracks') || '[]');
      } catch (e) {}
    }

    const heroSection = document.getElementById('album-hero-section');
    const playerSection = document.getElementById('album-player-section');

    const btnPlayAll = document.getElementById('btn-hero-play-all');
    const btnPlayOverlay = document.getElementById('btn-hero-play-overlay');
    const btnHeroShuffle = document.getElementById('btn-hero-shuffle');

    const playBtn = document.getElementById('btn-play-main');
    const btnNext = document.getElementById('btn-next-main');
    const btnPrev = document.getElementById('btn-prev-main');
    const btnShuffle = document.getElementById('btn-shuffle');
    const btnRepeat = document.getElementById('btn-repeat');
    const coverStage = document.getElementById('cover-stage');
    const volSlider = document.getElementById('vol-range-main') as HTMLInputElement;

    const btnToggleLyricsOverlay = document.getElementById('btn-toggle-lyrics-overlay');
    const btnCloseLyricsOverlay = document.getElementById('btn-close-lyrics-overlay');
    const mobileLyricsOverlay = document.getElementById('mobile-lyrics-overlay');

    const title = document.getElementById('main-track-title');
    const artist = document.getElementById('main-artist-name');
    const category = document.getElementById('main-category-badge');
    const seekBar = document.getElementById('seek-bar');

    const switchToPlayerView = () => {
      if (heroSection && playerSection) {
        heroSection.classList.add('fade-out');
        setTimeout(() => {
          heroSection.classList.add('hidden');
          heroSection.classList.remove('fade-out');
          playerSection.classList.remove('hidden');
          playerSection.classList.add('fade-in');
          setTimeout(() => playerSection.classList.remove('fade-in'), 400);
        }, 300);
      }
    };

    const updatePlayIconUI = (playing: boolean) => {
      const iconPlay = document.getElementById('icon-play-main');
      const iconPause = document.getElementById('icon-pause-main');
      if (playing) {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
      } else {
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
      }
    };

    const updateShuffleIconUI = (isShuffle: boolean) => {
      const btnShuffle = document.getElementById('btn-shuffle');
      if (btnShuffle) {
        if (isShuffle) {
          btnShuffle.classList.add('active');
        } else {
          btnShuffle.classList.remove('active');
        }
      }
    };

    const updateRepeatIconUI = (mode: string) => {
      const btnRepeat = document.getElementById('btn-repeat');
      if (btnRepeat) {
        btnRepeat.classList.remove('active', 'active-one');
        if (mode === 'all') {
          btnRepeat.classList.add('active');
        } else if (mode === 'one') {
          btnRepeat.classList.add('active', 'active-one');
        }
      }
    };

    const update5CardCarouselStage = (activeTrack: any) => {
      const idx = albumTracks.findIndex((t: any) => t.id === activeTrack.id);
      if (idx === -1) return;
      const count = albumTracks.length;
      if (count === 0) return;

      const getTrack = (offset: number) => albumTracks[(idx + offset + count) % count];

      const cardsData = [
        { slot: 0, track: getTrack(-2) },
        { slot: 1, track: getTrack(-1) },
        { slot: 2, track: activeTrack },
        { slot: 3, track: getTrack(1) },
        { slot: 4, track: getTrack(2) },
      ];

      cardsData.forEach(({ slot, track }) => {
        const img = document.getElementById(`card-img-${slot}`) as HTMLImageElement;
        if (img && track) {
          img.src = track.cover;
        }
      });
    };

    const triggerNext3D = () => {
      const queue = albumTracks;
      const cur = $currentTrack.get();
      if (cur) {
        const idx = queue.findIndex((t: any) => t.id === cur.id);
        const next = queue[(idx + 1) % queue.length];
        if (next) playTrack(next, true);
      }
    };

    const triggerPrev3D = () => {
      const queue = albumTracks;
      const cur = $currentTrack.get();
      if (cur) {
        const idx = queue.findIndex((t: any) => t.id === cur.id);
        const prev = queue[(idx - 1 + queue.length) % queue.length];
        if (prev) playTrack(prev, true);
      }
    };

    const handlePlayAlbum = (shuffle: boolean = false) => {
      if (albumTracks.length === 0) return;
      setQueue(albumTracks);
      switchToPlayerView();
      if (shuffle) {
        if (!$isShuffle.get()) toggleShuffle();
        const randomIndex = Math.floor(Math.random() * albumTracks.length);
        playTrack(albumTracks[randomIndex], true);
      } else {
        playTrack(albumTracks[0], true);
      }
    };

    btnPlayAll?.addEventListener('click', () => handlePlayAlbum(false));
    btnPlayOverlay?.addEventListener('click', () => handlePlayAlbum(false));
    btnHeroShuffle?.addEventListener('click', () => handlePlayAlbum(true));

    playBtn?.addEventListener('click', () => togglePlay());
    btnNext?.addEventListener('click', () => triggerNext3D());
    btnPrev?.addEventListener('click', () => triggerPrev3D());
    btnShuffle?.addEventListener('click', () => toggleShuffle());
    btnRepeat?.addEventListener('click', () => cycleRepeatMode());

    volSlider?.addEventListener('input', (e) => {
      setVolume(parseFloat((e.target as HTMLInputElement).value));
    });

    seekBar?.addEventListener('click', (e) => {
      const rect = seekBar.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      const dur = $duration.get();
      if (dur > 0) {
        AudioEngine.seek(pct * dur);
      }
    });

    coverStage?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#mobile-lyrics-overlay')) return;

      const card = (e.target as HTMLElement).closest('.cover-card');
      if (!card) return;
      const pos = card.getAttribute('data-pos');
      if (pos === '1') {
        triggerNext3D();
      } else if (pos === '-1') {
        triggerPrev3D();
      } else if (pos === '0') {
        togglePlay();
      }
    });

    btnToggleLyricsOverlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = !isMobileLyricsOverlayOpen;
      if (mobileLyricsOverlay) {
        if (isMobileLyricsOverlayOpen) {
          mobileLyricsOverlay.classList.add('active');
          setTimeout(() => window.dispatchEvent(new CustomEvent('realign-lrc')), 100);
        } else {
          mobileLyricsOverlay.classList.remove('active');
        }
      }
    });

    btnCloseLyricsOverlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = false;
      if (mobileLyricsOverlay) mobileLyricsOverlay.classList.remove('active');
    });

    // Playlist row listeners
    const playlistRows = document.querySelectorAll('.playlist-track-row');
    playlistRows.forEach((row) => {
      row.addEventListener('click', (e) => {
        const shareBtn = (e.target as HTMLElement).closest('[data-share-id]');
        if (shareBtn) {
          e.stopPropagation();
          const shareId = shareBtn.getAttribute('data-share-id');
          if (shareId) {
            const url = `${window.location.origin}${window.location.pathname}#/track/${shareId}`;
            navigator.clipboard.writeText(url);
          }
          return;
        }

        const id = row.getAttribute('data-track-id');
        const found = albumTracks.find((t) => t.id === id);
        if (found) {
          setQueue(albumTracks);
          switchToPlayerView();
          playTrack(found, true);
        }
      });
    });

    const highlightActivePlaylistItem = (activeId: string) => {
      playlistRows.forEach((row) => {
        const id = row.getAttribute('data-track-id');
        if (id === activeId) {
          row.classList.add('playing');
        } else {
          row.classList.remove('playing');
        }
      });
    };

    $currentTrack.subscribe((track) => {
      if (track) {
        if (title) title.textContent = track.title;
        if (artist) artist.textContent = track.artist;
        if (category) category.textContent = track.album.toUpperCase();

        update5CardCarouselStage(track);
        highlightActivePlaylistItem(track.id);

        // If the playing track belongs to this album and is actively playing, ensure player section is visible
        if (albumTracks.some((t: any) => t.id === track.id) && $isPlaying.get()) {
          if (heroSection && !heroSection.classList.contains('hidden')) {
            switchToPlayerView();
          }
        }
      }
    });

    $isPlaying.subscribe((playing) => {
      updatePlayIconUI(playing);
    });

    $isShuffle.subscribe((isShuffle: boolean) => {
      updateShuffleIconUI(isShuffle);
    });

    $repeatMode.subscribe((mode: string) => {
      updateRepeatIconUI(mode);
    });

    $currentTime.subscribe((time) => {
      const timeCurrent = document.getElementById('main-time-current');
      const seekFill = document.getElementById('seek-fill');
      if (timeCurrent) timeCurrent.textContent = formatTime(time);
      const dur = $duration.get();
      if (dur > 0 && seekFill) {
        seekFill.style.width = `${(time / dur) * 100}%`;
      }
    });

    $duration.subscribe((dur) => {
      const timeDuration = document.getElementById('main-time-duration');
      if (timeDuration) timeDuration.textContent = formatTime(dur);
    });

    $volume.subscribe((vol) => {
      const volSlider = document.getElementById('vol-range-main') as HTMLInputElement;
      if (volSlider) volSlider.value = vol.toString();
    });

    const current = $currentTrack.get();
    if (current && albumTracks.some((t: any) => t.id === current.id) && $isPlaying.get()) {
      if (heroSection && playerSection) {
        heroSection.classList.add('hidden');
        playerSection.classList.remove('hidden');
      }
      if (title) title.textContent = current.title;
      if (artist) artist.textContent = current.artist;
      if (category) category.textContent = current.album.toUpperCase();
      update5CardCarouselStage(current);
      highlightActivePlaylistItem(current.id);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAlbumHero);
  } else {
    initAlbumHero();
  }
</script>

