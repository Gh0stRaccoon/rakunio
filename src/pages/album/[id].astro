---
import Layout from '../../layouts/Layout.astro';
import { ALBUMS } from '../../data/tracks';

export function getStaticPaths() {
  return ALBUMS.map((album) => ({
    params: { id: album.id },
    props: { album, albumTracks: album.tracks }
  }));
}

const { album, albumTracks } = Astro.props;





const albumSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  'name': album.title,
  'byArtist': { '@type': 'MusicGroup', 'name': album.artist },
  'image': album.cover,
  'datePublished': `${album.year}`,
  'description': album.description,
  'numTracks': album.tracks.length,
  'track': album.tracks.map(t => ({
    '@type': 'MusicRecording',
    'name': t.title,
    'byArtist': { '@type': 'MusicGroup', 'name': t.artist },
    'duration': `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`
  }))
};

// Calculate total duration in minutes
const totalSecs = albumTracks.reduce((acc, t) => acc + (t.duration || 150), 0);
const totalMins = Math.round(totalSecs / 60);
---

<Layout 
  title={`${album.title} — Carpeta / Álbum | Rakunio`} 
  description={album.description}
  image={album.cover}
  jsonLd={albumSchema}
>
  <!-- Main Racoon Album Hero Showcase Workspace -->
  <div class="player-main-workspace glass-panel album-hero-mode">
    <!-- Top Showcase Area: Cover Portrait + Information -->
    <div class="album-hero-top">
      <!-- Left: Album Portrait Card with Aura Glow -->
      <div class="album-hero-portrait-container">
        <div class="aura-glow"></div>
        <div class="album-hero-cover-card glass-panel">
          <img src={album.cover} alt={album.title} class="hero-cover-img" />
          <button id="btn-hero-play-overlay" class="hero-play-overlay-btn" title="Reproducir todo el álbum">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-play-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right: Album Meta Header & Dynamic Markdown Info -->
      <div class="album-hero-info">
        <div class="album-badge-row">
          <span class="category-badge">COLECCIÓN / ÁLBUM</span>
          <span class="album-year-badge">{album.year}</span>
        </div>

        <h1 class="album-hero-title">{album.title}</h1>
        <div class="album-hero-artist-row">
          <span class="hero-artist-name">{album.artist}</span>
          <span class="meta-dot">•</span>
          <span class="hero-meta-stat">{albumTracks.length} canciones</span>
          <span class="meta-dot">•</span>
          <span class="hero-meta-stat">{totalMins} min aprox.</span>
        </div>

        <!-- Dynamic Markdown Description Card -->
        <div class="album-markdown-card glass-panel">
          <div class="markdown-body">
            {album.description.split('\n').map((paragraph) => {
              if (paragraph.startsWith('# ')) {
                return <h2 class="md-h2">{paragraph.replace(/^#\s+/, '')}</h2>;
              } else if (paragraph.startsWith('## ')) {
                return <h3 class="md-h3">{paragraph.replace(/^##\s+/, '')}</h3>;
              } else if (paragraph.startsWith('- ')) {
                return <li class="md-li">{paragraph.replace(/^- /, '')}</li>;
              } else if (paragraph.trim().length > 0) {
                return <p class="md-p">{paragraph}</p>;
              }
              return null;
            })}
          </div>
        </div>

        <!-- Primary Action Buttons -->
        <div class="album-hero-actions">
          <button id="btn-hero-play-all" class="hero-primary-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
            <span>Reproducir Todo</span>
          </button>

          <button id="btn-hero-shuffle" class="hero-secondary-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <polyline points="16 3 21 3 21 8"/>
              <line x1="4" y1="20" x2="21" y2="3"/>
              <polyline points="21 16 21 21 16 21"/>
              <line x1="15" y1="15" x2="21" y2="21"/>
            </svg>
            <span>Aleatorio</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom Playlist Section -->
    <div class="playlist-section">
      <div class="playlist-section-header">
        <div class="playlist-header-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="playlist-header-icon">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="quick-title">Lista de Canciones ({albumTracks.length})</span>
        </div>

        <button id="btn-toggle-playlist" class="playlist-toggle-btn" title="Mostrar / Ocultar lista">
          <span id="toggle-playlist-label">Ocultar lista</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toggle-icon">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </button>
      </div>

      <div class="playlist-vertical-list" id="playlist-container">
        {albumTracks.map((t, idx) => (
          <div class="playlist-track-row" data-track-id={t.id}>
            <span class="track-idx">{idx + 1}</span>
            <img src={t.cover} alt={t.title} class="playlist-thumb" data-audio-url={t.audioUrl} />
            <div class="playlist-track-meta" data-action="play">
              <span class="playlist-track-name">{t.title}</span>
              <span class="playlist-track-artist">{t.artist}</span>
            </div>
            <span class="playlist-track-album" data-action="play">{t.album}</span>
            <span class="playlist-track-duration">{t.duration || '2:30'}</span>
            <button class="row-share-btn" data-share-id={t.id} title="Copiar enlace de canción">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="row-share-icon">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div id="album-raw-tracks" data-tracks={JSON.stringify(albumTracks)} class="hidden"></div>
</Layout>

<script>
  import { AudioEngine } from '../../lib/audio/AudioEngine';
  import { 
    $currentTrack, 
    $isShuffle,
    playTrack,
    setQueue,
    toggleShuffle
  } from '../../lib/audio/PlayerStore';

  function initAlbumHero() {
    AudioEngine.init();
    
    const rawContainer = document.getElementById('album-raw-tracks');
    let albumTracks: any[] = [];
    if (rawContainer) {
      try {
        albumTracks = JSON.parse(rawContainer.getAttribute('data-tracks') || '[]');
      } catch (e) {}
    }

    const btnPlayAll = document.getElementById('btn-hero-play-all');
    const btnPlayOverlay = document.getElementById('btn-hero-play-overlay');
    const btnHeroShuffle = document.getElementById('btn-hero-shuffle');

    const handlePlayAlbum = (shuffle: boolean = false) => {
      if (albumTracks.length === 0) return;
      setQueue(albumTracks);
      if (shuffle) {
        if (!$isShuffle.get()) toggleShuffle();
        const randomIndex = Math.floor(Math.random() * albumTracks.length);
        playTrack(albumTracks[randomIndex], true);
      } else {
        playTrack(albumTracks[0], true);
      }
    };

    btnPlayAll?.addEventListener('click', () => handlePlayAlbum(false));
    btnPlayOverlay?.addEventListener('click', () => handlePlayAlbum(false));
    btnHeroShuffle?.addEventListener('click', () => handlePlayAlbum(true));

    // Playlist row listeners
    const playlistRows = document.querySelectorAll('.playlist-track-row');
    playlistRows.forEach((row) => {
      row.addEventListener('click', (e) => {
        const shareBtn = (e.target as HTMLElement).closest('[data-share-id]');
        if (shareBtn) {
          e.stopPropagation();
          const shareId = shareBtn.getAttribute('data-share-id');
          if (shareId) {
            const url = `${window.location.origin}${window.location.pathname}#/track/${shareId}`;
            navigator.clipboard.writeText(url);
          }
          return;
        }

        const id = row.getAttribute('data-track-id');
        const found = albumTracks.find((t) => t.id === id);
        if (found) {
          setQueue(albumTracks);
          playTrack(found, true);
        }
      });
    });

    const highlightActivePlaylistItem = (activeId: string) => {
      playlistRows.forEach((row) => {
        const id = row.getAttribute('data-track-id');
        if (id === activeId) {
          row.classList.add('playing');
        } else {
          row.classList.remove('playing');
        }
      });
    };

    $currentTrack.subscribe((track) => {
      if (track) {
        highlightActivePlaylistItem(track.id);
      }
    });

    const current = $currentTrack.get();
    if (current) {
      highlightActivePlaylistItem(current.id);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAlbumHero);
  } else {
    initAlbumHero();
  }
</script>

<style>
  .album-hero-mode {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px;
  }

  .album-hero-top {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 36px;
    align-items: start;
  }

  .album-hero-portrait-container {
    position: relative;
    width: 280px;
    height: 280px;
  }

  .aura-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(181, 105, 56, 0.35) 0%, rgba(0, 0, 0, 0) 70%);
    filter: blur(25px);
    z-index: 0;
    pointer-events: none;
    animation: auraPulse 6s ease-in-out infinite alternate;
  }

  @keyframes auraPulse {
    0% { opacity: 0.5; transform: scale(0.95); }
    100% { opacity: 0.85; transform: scale(1.05); }
  }

  .album-hero-cover-card {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-glass);
    border: 1px solid var(--glass-border);
  }

  .hero-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .album-hero-cover-card:hover .hero-cover-img {
    transform: scale(1.04);
  }

  .hero-play-overlay-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent-warm);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(181, 105, 56, 0.4);
    opacity: 0;
    transform: scale(0.85);
    transition: all 0.3s ease;
    z-index: 2;
  }

  .album-hero-cover-card:hover .hero-play-overlay-btn {
    opacity: 1;
    transform: scale(1);
  }

  .hero-play-icon {
    width: 26px;
    height: 26px;
    margin-left: 3px;
  }

  .album-hero-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .album-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: rgba(181, 105, 56, 0.15);
    color: var(--accent-warm);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .album-year-badge {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .album-hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .album-hero-artist-row {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .hero-artist-name {
    color: var(--accent-warm);
    font-weight: 700;
  }

  .meta-dot {
    color: var(--text-dim);
  }

  .album-markdown-card {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 16px 20px;
    margin-top: 6px;
    max-height: 220px;
    overflow-y: auto;
  }

  .markdown-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--text-main);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .md-h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 4px 0 2px 0;
  }

  .md-h3 {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--accent-warm);
    margin: 6px 0 2px 0;
  }

  .md-p {
    margin: 0;
    color: var(--text-muted);
  }

  .md-li {
    margin-left: 16px;
    color: var(--text-muted);
    list-style-type: disc;
  }

  .album-hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
  }

  .hero-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: var(--text-main);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    transition: var(--transition-smooth);
  }

  .hero-primary-btn:hover {
    background: var(--accent-warm);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(181, 105, 56, 0.3);
  }

  .hero-secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: rgba(255, 255, 255, 0.6);
    color: var(--text-main);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .hero-secondary-btn:hover {
    background: white;
    transform: translateY(-2px);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  /* Playlist section override */
  .playlist-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .playlist-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .playlist-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .playlist-header-icon {
    width: 20px;
    height: 20px;
    color: var(--accent-warm);
  }

  .playlist-toggle-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .playlist-vertical-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .playlist-track-row {
    display: grid;
    grid-template-columns: 32px 48px 1fr 140px 60px 40px;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid transparent;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .playlist-track-row:hover {
    background: rgba(255, 255, 255, 0.8);
    transform: translateX(4px);
  }

  .playlist-track-row.playing {
    background: rgba(181, 105, 56, 0.12);
    border-color: rgba(181, 105, 56, 0.3);
  }

  .playlist-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
  }

  .playlist-track-meta {
    display: flex;
    flex-direction: column;
  }

  .playlist-track-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .playlist-track-artist {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .playlist-track-album {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .playlist-track-duration {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    text-align: right;
  }

  .row-share-btn {
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .row-share-btn:hover {
    color: var(--accent-warm);
  }

  .row-share-icon {
    width: 16px;
    height: 16px;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 960px) {
    .album-hero-top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .album-hero-portrait-container {
      width: 220px;
      height: 220px;
    }

    .album-badge-row,
    .album-hero-artist-row,
    .album-hero-actions {
      justify-content: center;
    }

    .playlist-track-row {
      grid-template-columns: 28px 40px 1fr 50px 36px;
    }

    .playlist-track-album {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .album-hero-mode {
      padding: 16px;
    }

    .album-hero-title {
      font-size: 1.8rem;
    }

    .album-hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-primary-btn,
    .hero-secondary-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
