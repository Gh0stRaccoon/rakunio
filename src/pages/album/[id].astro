---
import Layout from '../../layouts/Layout.astro';
import CanvasVisualizer from '../../components/CanvasVisualizer.astro';
import LrcLyrics from '../../components/LrcLyrics.astro';
import { ALBUMS } from '../../data/tracks';

export function getStaticPaths() {
  return ALBUMS.map((album) => ({
    params: { id: album.id },
    props: { album, albumTracks: album.tracks }
  }));
}

const { album, albumTracks } = Astro.props;

function formatMarkdown(content?: string): string {
  if (!content) return `<p class="md-p">${album.description}</p>`;
  return content
    .split('\n\n')
    .map((paragraph) => {
      let trimmed = paragraph.trim();
      if (!trimmed) return '';
      if (trimmed.startsWith('# ')) {
        return `<h2 class="md-title">${trimmed.replace(/^#\s+/, '')}</h2>`;
      }
      if (trimmed.startsWith('## ')) {
        return `<h3 class="md-subtitle">${trimmed.replace(/^##\s+/, '')}</h3>`;
      }
      if (trimmed.startsWith('---')) {
        return `<hr class="md-divider" />`;
      }
      if (trimmed.startsWith('- ')) {
        const items = trimmed
          .split('\n')
          .map((line) => {
            const cleanLine = line
              .replace(/^-\s+/, '')
              .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
              .replace(/\*(.*?)\*/g, '<em>$1</em>');
            return `<li>${cleanLine}</li>`;
          })
          .join('');
        return `<ul class="md-list">${items}</ul>`;
      }
      const formatted = trimmed
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>');
      return `<p class="md-p">${formatted}</p>`;
    })
    .join('');
}

const markdownHtml = formatMarkdown(album.markdownInfo);

const albumSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  'name': album.title,
  'byArtist': { '@type': 'MusicGroup', 'name': album.artist },
  'image': album.cover,
  'datePublished': `${album.year}`,
  'description': album.description,
  'numTracks': album.tracks.length,
  'track': album.tracks.map(t => ({
    '@type': 'MusicRecording',
    'name': t.title,
    'byArtist': { '@type': 'MusicGroup', 'name': t.artist },
    'duration': `PT${Math.floor(t.duration / 60)}M${t.duration % 60}S`
  }))
};
---

<Layout 
  title={`${album.title} — Beats | Rakunio`} 
  description={album.description}
  image={album.cover}
  jsonLd={albumSchema}
>
  <!-- Main Racoon Player Workspace Shell for Album / Folder Collection -->
  <div class="player-main-workspace glass-panel" id="album-main-workspace" data-album-id={album.id}>
    <!-- Top Area: 2 Columns (Exact 1.35fr 1fr Grid Layout) -->
    <div class="player-top-row">
      <!-- Left Column: 3D Stage + Controls -->
      <div class="player-left-col">
        <div class="album-aura-container">
          <div class="aura-glow"></div>
          
          <!-- Continuous 5-Card 3D Cover Stage -->
          <div class="cover-stage" id="cover-stage">
            <div class="cover-card" data-card-slot="0" data-pos="-2">
              <img id="card-img-0" src={album.cover} alt="Cover" class="card-img" />
            </div>

            <div class="cover-card" data-card-slot="1" data-pos="-1" title="Canción anterior">
              <img id="card-img-1" src={album.cover} alt="Cover" class="card-img" />
              <div class="card-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
                  <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <div class="cover-card" data-card-slot="2" data-pos="0" id="cover-slide-container">
              <img id="card-img-2" src={album.cover} alt="Cover" class="card-img main-img" />
              <button class="showcase-play-overlay-btn" id="showcase-cover-play-btn" title="Reproducir carpeta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="showcase-play-icon">
                  <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
                </svg>
              </button>
            </div>

            <div class="cover-card" data-card-slot="3" data-pos="1" title="Siguiente canción">
              <img id="card-img-3" src={album.cover} alt="Cover" class="card-img" />
              <div class="card-overlay">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
                  <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <div class="cover-card" data-card-slot="4" data-pos="2">
              <img id="card-img-4" src={album.cover} alt="Cover" class="card-img" />
            </div>

            <div class="cover-visualizer-overlay" id="cover-visualizer-overlay">
              <CanvasVisualizer />
            </div>

            <div class="mobile-lyrics-overlay" id="mobile-lyrics-overlay">
              <div class="overlay-header">
                <span class="overlay-title">Letra</span>
                <button id="btn-close-lyrics-overlay" class="overlay-close-btn" title="Cerrar letra">✕</button>
              </div>
              <div class="overlay-lyrics-body">
                <LrcLyrics />
              </div>
            </div>
          </div>

          <button id="btn-toggle-lyrics-overlay" class="mobile-lyrics-toggle-btn" title="Ver letra sobre carátula">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lyrics-toggle-icon">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              <line x1="9" y1="9" x2="15" y2="9"/>
              <line x1="9" y1="13" x2="13" y2="13"/>
            </svg>
            <span class="lyrics-toggle-label">Ver Letra</span>
          </button>
        </div>

        <!-- Showcase Action Bar (Visible in presentation mode) -->
        <div class="showcase-action-bar" id="showcase-action-bar">
          <button id="showcase-btn-play-all" class="showcase-play-all-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-play-icon">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
            </svg>
            <span>Reproducir Todo</span>
          </button>
          
          <button id="showcase-btn-shuffle-all" class="showcase-shuffle-btn" title="Reproducción Aleatoria">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
              <polyline points="16 3 21 3 21 8"/>
              <line x1="4" y1="20" x2="21" y2="3"/>
              <polyline points="21 16 21 21 16 21"/>
              <line x1="15" y1="15" x2="21" y2="21"/>
            </svg>
          </button>
        </div>

        <!-- Player Controls (Visible when active player mode) -->
        <div class="player-active-controls hidden" id="player-active-controls">
          <div class="progress-section">
            <span id="main-time-current" class="time-stamp">0:00</span>
            <div class="seek-bar-track" id="seek-bar">
              <div id="seek-fill" class="seek-bar-fill"></div>
            </div>
            <span id="main-time-duration" class="time-stamp">2:25</span>
          </div>

          <div class="controls-row">
            <button id="btn-shuffle" class="icon-btn" title="Modo Aleatorio">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
                <polyline points="16 3 21 3 21 8"/>
                <line x1="4" y1="20" x2="21" y2="3"/>
                <polyline points="21 16 21 21 16 21"/>
                <line x1="15" y1="15" x2="21" y2="21"/>
              </svg>
            </button>

            <button id="btn-prev-main" class="icon-btn" title="Anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
                <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"/>
                <line x1="5" y1="19" x2="5" y2="5" stroke-linecap="round"/>
              </svg>
            </button>

            <button id="btn-play-main" class="main-play-btn" title="Reproducir / Pausar">
              <svg id="icon-play-main" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="main-play-icon">
                <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/>
              </svg>
              <svg id="icon-pause-main" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="main-play-icon hidden">
                <rect x="6" y="4" width="4" height="16" fill="currentColor"/>
                <rect x="14" y="4" width="4" height="16" fill="currentColor"/>
              </svg>
            </button>

            <button id="btn-next-main" class="icon-btn" title="Siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
                <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"/>
                <line x1="19" y1="5" x2="19" y2="19" stroke-linecap="round"/>
              </svg>
            </button>

            <button id="btn-repeat" class="icon-btn" title="Modo Repetir">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon">
                <polyline points="17 1 21 5 17 9"/>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                <polyline points="7 23 3 19 7 15"/>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
              </svg>
            </button>
          </div>

          <div class="volume-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="vol-icon">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/>
            </svg>
            <input id="vol-range-main" type="range" min="0" max="1" step="0.01" value="0.8" class="vol-slider-main" />
          </div>
        </div>
      </div>

      <!-- Right Column: Meta Header + Dynamic Body (Showcase Info vs Lyrics) -->
      <div class="player-right-col">
        <div class="track-header-meta">
          <span id="main-category-badge" class="category-badge">{album.title.toUpperCase()}</span>
          <div class="title-like-row">
            <h1 id="main-track-title" class="track-title">{album.title}</h1>
            
            <div class="header-action-group">
              <button id="btn-share-main" class="action-btn" title="Compartir canción">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-icon">
                  <circle cx="18" cy="5" r="3"/>
                  <circle cx="6" cy="12" r="3"/>
                  <circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
              </button>
              
              <button id="btn-like" class="like-btn" title="Favorito">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="like-icon">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
            </div>
          </div>
          <span id="main-artist-name" class="artist-name">{album.artist} • {album.tracks.length} canciones</span>
        </div>

        <!-- Body Content Option 1: Markdown Showcase Info (Presentation Mode) -->
        <div class="album-markdown-container" id="album-markdown-container">
          <div class="markdown-content" set:html={markdownHtml} />
        </div>

        <!-- Body Content Option 2: Lyrics Desktop Wrapper (Active Player Mode) -->
        <div class="lyrics-wrapper-desktop hidden" id="lyrics-wrapper-desktop">
          <LrcLyrics />
        </div>
      </div>
    </div>

    <!-- Bottom Full Width Area: Playlist Section -->
    <div class="playlist-section">
      <div class="playlist-section-header">
        <div class="playlist-header-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="playlist-header-icon">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="quick-title">Colección: {album.title} ({albumTracks.length} beats)</span>
        </div>

        <button id="btn-toggle-playlist" class="playlist-toggle-btn" title="Mostrar / Ocultar lista">
          <span id="toggle-playlist-label">Ocultar lista</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toggle-icon">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
        </button>
      </div>

      <div class="playlist-vertical-list" id="playlist-container">
        {albumTracks.map((t, idx) => (
          <div class="playlist-track-row" data-track-id={t.id}>
            <span class="track-idx">{idx + 1}</span>
            <img src={t.cover} alt={t.title} class="playlist-thumb" data-audio-url={t.audioUrl} />
            <div class="playlist-track-meta" data-action="play">
              <span class="playlist-track-name">{t.title}</span>
              <span class="playlist-track-artist">{t.artist}</span>
            </div>
            <span class="playlist-track-album" data-action="play">{t.album}</span>
            <span class="playlist-track-duration">{t.duration || '2:30'}</span>
            <button class="row-share-btn" data-share-id={t.id} title="Copiar enlace de canción">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="row-share-icon">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { 
    $currentTrack, 
    $isPlaying, 
    $currentTime, 
    $duration, 
    $volume, 
    $isShuffle, 
    $repeatMode, 
    $queue,
    playTrack, 
    togglePlay, 
    playNext, 
    playPrevious, 
    toggleShuffle, 
    cycleRepeatMode, 
    setVolume,
    setQueue
  } from '../../lib/audio/PlayerStore';
  import { AudioEngine } from '../../lib/audio/AudioEngine';
  import { ALBUMS } from '../../data/tracks';

  const currentAlbumId = document.getElementById('album-main-workspace')?.getAttribute('data-album-id') || 'rakunio';
  const currentAlbum = ALBUMS.find(a => a.id === currentAlbumId) || ALBUMS[0];

  let isAnimating = false;
  let isPlaylistVisible = true;
  let isMobileLyricsOverlayOpen = false;

  function initAlbumViewRole() {
    const cur = $currentTrack.get();
    if (cur && cur.albumId === currentAlbumId) {
      activatePlayerMode(cur);
    } else {
      activateShowcaseMode();
    }
  }

  function activateShowcaseMode() {
    const showcaseBar = document.getElementById('showcase-action-bar');
    const playerControls = document.getElementById('player-active-controls');
    const markdownContainer = document.getElementById('album-markdown-container');
    const lyricsWrapper = document.getElementById('lyrics-wrapper-desktop');
    const showcasePlayOverlayBtn = document.getElementById('showcase-cover-play-btn');
    const mainTitle = document.getElementById('main-track-title');
    const mainArtist = document.getElementById('main-artist-name');
    const mainBadge = document.getElementById('main-category-badge');

    if (showcaseBar) showcaseBar.classList.remove('hidden');
    if (playerControls) playerControls.classList.add('hidden');
    if (markdownContainer) markdownContainer.classList.remove('hidden');
    if (lyricsWrapper) lyricsWrapper.classList.add('hidden');
    if (showcasePlayOverlayBtn) showcasePlayOverlayBtn.classList.remove('hidden');

    if (mainTitle && currentAlbum) mainTitle.textContent = currentAlbum.title;
    if (mainArtist && currentAlbum) mainArtist.textContent = `${currentAlbum.artist} • ${currentAlbum.tracks.length} canciones`;
    if (mainBadge && currentAlbum) mainBadge.textContent = `COLECCIÓN: ${currentAlbum.title.toUpperCase()}`;

    // Reset center card image to album cover
    const mainCardImg = document.getElementById('card-img-2') as HTMLImageElement;
    if (mainCardImg && currentAlbum) mainCardImg.src = currentAlbum.cover;
  }

  function activatePlayerMode(track: any) {
    const showcaseBar = document.getElementById('showcase-action-bar');
    const playerControls = document.getElementById('player-active-controls');
    const markdownContainer = document.getElementById('album-markdown-container');
    const lyricsWrapper = document.getElementById('lyrics-wrapper-desktop');
    const showcasePlayOverlayBtn = document.getElementById('showcase-cover-play-btn');
    const mainTitle = document.getElementById('main-track-title');
    const mainArtist = document.getElementById('main-artist-name');
    const mainBadge = document.getElementById('main-category-badge');

    if (showcaseBar) showcaseBar.classList.add('hidden');
    if (playerControls) playerControls.classList.remove('hidden');
    if (markdownContainer) markdownContainer.classList.add('hidden');
    if (lyricsWrapper) lyricsWrapper.classList.remove('hidden');
    if (showcasePlayOverlayBtn) showcasePlayOverlayBtn.classList.add('hidden');

    if (track) {
      if (mainTitle) mainTitle.textContent = track.title;
      if (mainArtist) mainArtist.textContent = track.artist;
      if (mainBadge) mainBadge.textContent = track.album.toUpperCase();

      update5CardCarouselStage(track);
      highlightActivePlaylistItem(track.id);
    }
  }

  function setupAlbumPageListeners() {
    if (currentAlbum && currentAlbum.tracks.length > 0) {
      setQueue(currentAlbum.tracks);
    }

    initAlbumViewRole();

    const btnPlayAll = document.getElementById('showcase-btn-play-all');
    const btnShuffleAll = document.getElementById('showcase-btn-shuffle-all');
    const coverPlayBtn = document.getElementById('showcase-cover-play-btn');

    btnPlayAll?.addEventListener('click', () => {
      if (currentAlbum && currentAlbum.tracks.length > 0 && currentAlbum.tracks[0]) {
        playTrack(currentAlbum.tracks[0], true);
      }
    });

    coverPlayBtn?.addEventListener('click', () => {
      if (currentAlbum && currentAlbum.tracks.length > 0 && currentAlbum.tracks[0]) {
        playTrack(currentAlbum.tracks[0], true);
      }
    });

    btnShuffleAll?.addEventListener('click', () => {
      if (currentAlbum && currentAlbum.tracks.length > 0) {
        toggleShuffle();
        const randomIdx = Math.floor(Math.random() * currentAlbum.tracks.length);
        const target = currentAlbum.tracks[randomIdx];
        if (target) playTrack(target, true);
      }
    });

    const playBtn = document.getElementById('btn-play-main');
    const btnNext = document.getElementById('btn-next-main');
    const btnPrev = document.getElementById('btn-prev-main');
    const btnShuffle = document.getElementById('btn-shuffle');
    const btnRepeat = document.getElementById('btn-repeat');
    const btnShareMain = document.getElementById('btn-share-main');
    const btnTogglePlaylist = document.getElementById('btn-toggle-playlist');
    const toggleLabel = document.getElementById('toggle-playlist-label');
    const playlistContainer = document.getElementById('playlist-container');
    const coverStage = document.getElementById('cover-stage');
    const volSlider = document.getElementById('vol-range-main') as HTMLInputElement;
    const mobileLyricsOverlay = document.getElementById('mobile-lyrics-overlay');
    const btnToggleLyricsOverlay = document.getElementById('btn-toggle-lyrics-overlay');
    const btnCloseLyricsOverlay = document.getElementById('btn-close-lyrics-overlay');
    const seekBar = document.getElementById('seek-bar');

    playBtn?.addEventListener('click', () => togglePlay());
    btnNext?.addEventListener('click', () => triggerNext3D());
    btnPrev?.addEventListener('click', () => triggerPrev3D());
    btnShuffle?.addEventListener('click', () => toggleShuffle());
    btnRepeat?.addEventListener('click', () => cycleRepeatMode());

    btnShareMain?.addEventListener('click', () => {
      const cur = $currentTrack.get();
      if (cur) copyTrackShareLink(cur.id);
    });

    btnToggleLyricsOverlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = !isMobileLyricsOverlayOpen;
      if (mobileLyricsOverlay) {
        if (isMobileLyricsOverlayOpen) {
          mobileLyricsOverlay.classList.add('active');
          setTimeout(() => window.dispatchEvent(new CustomEvent('realign-lrc')), 100);
        } else {
          mobileLyricsOverlay.classList.remove('active');
        }
      }
    });

    btnCloseLyricsOverlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = false;
      if (mobileLyricsOverlay) mobileLyricsOverlay.classList.remove('active');
    });

    coverStage?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#mobile-lyrics-overlay')) return;
      if ((e.target as HTMLElement).closest('#showcase-cover-play-btn')) return;
      const card = (e.target as HTMLElement).closest('.cover-card');
      if (!card) return;
      const pos = card.getAttribute('data-pos');
      if (pos === '1') {
        triggerNext3D();
      } else if (pos === '-1') {
        triggerPrev3D();
      } else if (pos === '0') {
        togglePlay();
      }
    });

    btnTogglePlaylist?.addEventListener('click', () => {
      isPlaylistVisible = !isPlaylistVisible;
      if (playlistContainer) {
        if (isPlaylistVisible) {
          playlistContainer.classList.remove('collapsed');
          if (toggleLabel) toggleLabel.textContent = 'Ocultar lista';
        } else {
          playlistContainer.classList.add('collapsed');
          if (toggleLabel) toggleLabel.textContent = 'Mostrar lista';
        }
      }
    });

    volSlider?.addEventListener('input', (e) => {
      setVolume(parseFloat((e.target as HTMLInputElement).value));
    });

    seekBar?.addEventListener('click', (e) => {
      const rect = seekBar.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      const dur = $duration.get();
      if (dur > 0) {
        AudioEngine.seek(pct * dur);
      }
    });

    // Playlist row listeners
    const playlistRows = document.querySelectorAll('.playlist-track-row');
    playlistRows.forEach((row) => {
      row.addEventListener('click', (e) => {
        const shareBtn = (e.target as HTMLElement).closest('[data-share-id]');
        if (shareBtn) {
          e.stopPropagation();
          const shareId = shareBtn.getAttribute('data-share-id');
          if (shareId) copyTrackShareLink(shareId);
          return;
        }

        const id = row.getAttribute('data-track-id');
        const found = currentAlbum?.tracks.find(t => t.id === id);
        if (found) {
          playTrack(found, true);
        }
      });
    });

    extractPlaylistID3Covers();

    updatePlayIconUI($isPlaying.get());
    updateShuffleIconUI($isShuffle.get());
    updateRepeatIconUI($repeatMode.get());

    const cur = $currentTrack.get();
    if (cur && cur.albumId === currentAlbumId) {
      activatePlayerMode(cur);
    }
  }

  $currentTrack.subscribe((track) => {
    if (track && track.albumId === currentAlbumId) {
      activatePlayerMode(track);
    }
  });

  $isPlaying.subscribe((playing) => {
    updatePlayIconUI(playing);
  });

  $isShuffle.subscribe((isShuffle) => {
    updateShuffleIconUI(isShuffle);
  });

  $repeatMode.subscribe((mode) => {
    updateRepeatIconUI(mode);
  });

  $currentTime.subscribe((time) => {
    const timeCurrent = document.getElementById('main-time-current');
    const seekFill = document.getElementById('seek-fill');
    if (timeCurrent) timeCurrent.textContent = formatTime(time);
    const dur = $duration.get();
    if (dur > 0 && seekFill) {
      seekFill.style.width = `${(time / dur) * 100}%`;
    }
  });

  $duration.subscribe((dur) => {
    const timeDuration = document.getElementById('main-time-duration');
    if (timeDuration) timeDuration.textContent = formatTime(dur);
  });

  $volume.subscribe((vol) => {
    const volSlider = document.getElementById('vol-range-main') as HTMLInputElement;
    if (volSlider) volSlider.value = vol.toString();
  });

  function triggerNext3D() {
    if (isAnimating) return;
    isAnimating = true;
    
    const cards = document.querySelectorAll('.cover-card');
    cards.forEach((card) => {
      let currentPos = parseInt(card.getAttribute('data-pos') || '0', 10);
      let newPos = currentPos - 1;
      if (newPos < -2) newPos = 2;
      card.setAttribute('data-pos', newPos.toString());
    });

    setTimeout(() => {
      playNext();
      isAnimating = false;
    }, 380);
  }

  function triggerPrev3D() {
    if (isAnimating) return;
    isAnimating = true;
    
    const cards = document.querySelectorAll('.cover-card');
    cards.forEach((card) => {
      let currentPos = parseInt(card.getAttribute('data-pos') || '0', 10);
      let newPos = currentPos + 1;
      if (newPos > 2) newPos = -2;
      card.setAttribute('data-pos', newPos.toString());
    });

    setTimeout(() => {
      playPrevious();
      isAnimating = false;
    }, 380);
  }

  function update5CardCarouselStage(currentTrack: any) {
    const queue = $queue.get();
    if (!queue || queue.length === 0) return;
    const currentIndex = queue.findIndex(t => t.id === currentTrack.id);
    if (currentIndex === -1) return;

    const cards = document.querySelectorAll('.cover-card');

    cards.forEach((card) => {
      const pos = parseInt(card.getAttribute('data-pos') || '0', 10);
      const targetIndex = (currentIndex + pos + queue.length * 100) % queue.length;
      const targetTrack = queue[targetIndex];
      const img = card.querySelector('img') as HTMLImageElement;

      if (img && targetTrack) {
        img.src = targetTrack.cover;
        img.alt = targetTrack.title;
      }
    });
  }

  function highlightActivePlaylistItem(activeTrackId: string) {
    const rows = document.querySelectorAll('.playlist-track-row');
    rows.forEach((row) => {
      const id = row.getAttribute('data-track-id');
      if (id === activeTrackId) {
        row.classList.add('active');
      } else {
        row.classList.remove('active');
      }
    });
  }

  function updatePlayIconUI(isPlaying: boolean) {
    const iconPlay = document.getElementById('icon-play-main');
    const iconPause = document.getElementById('icon-pause-main');

    if (isPlaying) {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
    } else {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
    }
  }

  function updateShuffleIconUI(isShuffle: boolean) {
    const btn = document.getElementById('btn-shuffle');
    if (btn) {
      if (isShuffle) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    }
  }

  function updateRepeatIconUI(mode: string) {
    const btn = document.getElementById('btn-repeat');
    if (btn) {
      if (mode !== 'none') {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    }
  }

  async function extractPlaylistID3Covers() {
    const rows = document.querySelectorAll('.playlist-track-row');
    const { extractAudioMetadata } = await import('../../lib/audio/MetadataExtractor');

    rows.forEach(async (row) => {
      const thumb = row.querySelector('.playlist-thumb') as HTMLImageElement;
      if (!thumb) return;

      const audioUrl = thumb.getAttribute('data-audio-url');
      if (!audioUrl) return;

      try {
        const meta = await extractAudioMetadata(audioUrl);
        if (meta.coverUrl) {
          thumb.src = meta.coverUrl;
        }
      } catch (e) {
        // Fallback to static cover silently
      }
    });
  }

  function formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function copyTrackShareLink(trackId: string) {
    const url = `${window.location.origin}${window.location.pathname}?track=${trackId}`;
    navigator.clipboard.writeText(url).then(() => {
      showToast('¡Enlace de canción copiado al portapapeles!');
    }).catch(() => {
      showToast('Copiar enlace: ' + url);
    });
  }

  function showToast(message: string) {
    let toast = document.getElementById('toast-notify');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'toast-notify';
      toast.className = 'toast-notify hidden';
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.classList.remove('hidden');
    toast.classList.add('show');

    setTimeout(() => {
      toast?.classList.remove('show');
      toast?.classList.add('hidden');
    }, 2800);
  }

  document.addEventListener('astro:page-load', setupAlbumPageListeners);
  setupAlbumPageListeners();
</script>

