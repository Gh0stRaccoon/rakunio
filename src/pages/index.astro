---
import Layout from "../layouts/Layout.astro";
import CanvasVisualizer from "../components/CanvasVisualizer.astro";
import LrcLyrics from "../components/LrcLyrics.astro";
import { TRACKS, ALBUMS } from "../data/tracks";
import { withBase } from "../utils/base";
import type { Track } from "../types/track";

const fallbackTrack: Track = {
  id: "fallback",
  title: "Sin título",
  artist: "Rakun.io",
  album: "rakunio",
  albumId: "rakunio",
  duration: 150,
  cover: withBase("/favicon.svg"),
  audioUrl: "",
};

const defaultTrack: Track = TRACKS[0] || fallbackTrack;
---

<Layout>
  <!-- Main Racoon Player Workspace Shell -->
  <div class="player-main-workspace glass-panel">
    <!-- Top Area: 2 Columns (Left: Cover & Controls, Right: Track Info & Lyrics) -->
    <div class="player-top-row">
      <!-- Left Column: 5-Card Continuous 3D CoverFlow Stage + Visualizer + Controls -->
      <div class="player-left-col">
        <div class="album-aura-container">
          <div class="aura-glow"></div>

          <!-- Continuous 5-Card 3D Cover Stage -->
          <div class="cover-stage" id="cover-stage">
            <!-- 5 Persistent Cards mapped dynamically by data-pos -->
            <div class="cover-card" data-card-slot="0" data-pos="-2">
              <img
                id="card-img-0"
                src={defaultTrack.cover}
                alt="Cover"
                class="card-img"
              />
            </div>

            <div
              class="cover-card"
              data-card-slot="1"
              data-pos="-1"
              title="Canción anterior"
            >
              <img
                id="card-img-1"
                src={defaultTrack.cover}
                alt="Cover"
                class="card-img"
              />
              <div class="card-overlay">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="card-icon"
                >
                  <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"
                  ></polygon>
                </svg>
              </div>
            </div>

            <div
              class="cover-card"
              data-card-slot="2"
              data-pos="0"
              id="cover-slide-container"
            >
              <img
                id="card-img-2"
                src={defaultTrack.cover}
                alt="Cover"
                class="card-img main-img"
              />
            </div>

            <div
              class="cover-card"
              data-card-slot="3"
              data-pos="1"
              title="Siguiente canción"
            >
              <img
                id="card-img-3"
                src={defaultTrack.cover}
                alt="Cover"
                class="card-img"
              />
              <div class="card-overlay">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="card-icon"
                >
                  <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"
                  ></polygon>
                </svg>
              </div>
            </div>

            <div class="cover-card" data-card-slot="4" data-pos="2">
              <img
                id="card-img-4"
                src={defaultTrack.cover}
                alt="Cover"
                class="card-img"
              />
            </div>

            <!-- Free Spectrum Visualizer Overlay Centered Vertically Over Active Cover Card -->
            <div class="cover-visualizer-overlay" id="cover-visualizer-overlay">
              <CanvasVisualizer />
            </div>

            <!-- Fixed Center Active Mobile Lyrics Backdrop Overlay (Mobile Only) -->
            <div class="mobile-lyrics-overlay" id="mobile-lyrics-overlay">
              <div class="overlay-header">
                <span class="overlay-title">Letra</span>
                <button
                  id="btn-close-lyrics-overlay"
                  class="overlay-close-btn"
                  title="Cerrar letra">✕</button
                >
              </div>
              <div class="overlay-lyrics-body">
                <LrcLyrics />
              </div>
            </div>
          </div>

          <!-- Mobile Lyrics Toggle Floating Action Button (Mobile Only) -->
          <button
            id="btn-toggle-lyrics-overlay"
            class="mobile-lyrics-toggle-btn"
            title="Ver letra sobre carátula"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="lyrics-toggle-icon"
            >
              <path
                d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
              ></path>
              <line x1="9" y1="9" x2="15" y2="9"></line>
              <line x1="9" y1="13" x2="13" y2="13"></line>
            </svg>
            <span class="lyrics-toggle-label">Ver Letra</span>
          </button>
        </div>

        <!-- Progress & Seek Bar -->
        <div class="progress-section">
          <span id="main-time-current" class="time-stamp">0:00</span>
          <div class="seek-bar-track" id="seek-bar">
            <div id="seek-fill" class="seek-bar-fill"></div>
          </div>
          <span id="main-time-duration" class="time-stamp">2:25</span>
        </div>

        <!-- Control Action Buttons -->
        <div class="controls-row">
          <button id="btn-shuffle" class="icon-btn" title="Modo Aleatorio">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="icon"
            >
              <polyline points="16 3 21 3 21 8"></polyline>
              <line x1="4" y1="20" x2="21" y2="3"></line>
              <polyline points="21 16 21 21 16 21"></polyline>
              <line x1="15" y1="15" x2="21" y2="21"></line>
            </svg>
          </button>

          <button id="btn-prev-main" class="icon-btn" title="Anterior">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="icon"
            >
              <polygon points="19 20 9 12 19 4 19 20" fill="currentColor"
              ></polygon>
              <line x1="5" y1="19" x2="5" y2="5" stroke-linecap="round"></line>
            </svg>
          </button>

          <button
            id="btn-play-main"
            class="main-play-btn"
            title="Reproducir / Pausar"
          >
            <svg
              id="icon-play-main"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="main-play-icon"
            >
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"
              ></polygon>
            </svg>
            <svg
              id="icon-pause-main"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="main-play-icon hidden"
            >
              <rect x="6" y="4" width="4" height="16" fill="currentColor"
              ></rect>
              <rect x="14" y="4" width="4" height="16" fill="currentColor"
              ></rect>
            </svg>
          </button>

          <button id="btn-next-main" class="icon-btn" title="Siguiente">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="icon"
            >
              <polygon points="5 4 15 12 5 20 5 4" fill="currentColor"
              ></polygon>
              <line x1="19" y1="5" x2="19" y2="19" stroke-linecap="round"
              ></line>
            </svg>
          </button>

          <button id="btn-repeat" class="icon-btn" title="Modo Repetir">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="icon"
            >
              <polyline points="17 1 21 5 17 9"></polyline>
              <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
              <polyline points="7 23 3 19 7 15"></polyline>
              <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
            </svg>
          </button>
        </div>

        <!-- Volume Bar -->
        <div class="volume-row">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="vol-icon"
          >
            <polygon
              points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
              fill="currentColor"></polygon>
          </svg>
          <input
            id="vol-range-main"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="0.8"
            class="vol-slider-main"
          />
        </div>
      </div>

      <!-- Right Column: Track Info + Synced Lyrics (Desktop) -->
      <div class="player-right-col">
        <div class="track-header-meta">
          <span id="main-category-badge" class="category-badge"
            >RAKOON BEATS</span
          >
          <div class="title-like-row">
            <h1 id="main-track-title" class="track-title">
              {defaultTrack.title}
            </h1>

            <div class="header-action-group">
              <button
                id="btn-share-main"
                class="action-btn"
                title="Compartir canción"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="action-icon"
                >
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
              </button>

              <button id="btn-like" class="like-btn" title="Favorito">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="like-icon"
                >
                  <path
                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                  ></path>
                </svg>
              </button>
            </div>
          </div>
          <span id="main-artist-name" class="artist-name"
            >{defaultTrack.artist}</span
          >
        </div>

        <!-- Synced Lyrics Component (Desktop Column) -->
        <div class="lyrics-wrapper-desktop">
          <LrcLyrics />
        </div>
      </div>
    </div>

    <!-- Bottom Full Width Area: Playlist Section -->
    <div class="playlist-section">
      <div class="playlist-section-header">
        <div class="playlist-header-title">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="playlist-header-icon"
          >
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span class="quick-title"
            >Lista de Beats ({TRACKS.length} canciones)</span
          >
        </div>

        <!-- Dynamic Folder Filter Tabs (all / folder names) -->
        <div class="folder-filter-tabs">
          <button class="filter-tab active" data-filter-folder="all"
            >all ({TRACKS.length})</button
          >
          {
            ALBUMS.map((album) => (
              <button class="filter-tab" data-filter-folder={album.id}>
                {album.title}
              </button>
            ))
          }
        </div>

        <button
          id="btn-toggle-playlist"
          class="playlist-toggle-btn"
          title="Mostrar / Ocultar lista"
        >
          <span id="toggle-playlist-label">Ocultar lista</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="toggle-icon"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <div class="playlist-vertical-list" id="playlist-container">
        {
          TRACKS.map((t, idx) => (
            <div
              class="playlist-track-row"
              data-track-id={t.id}
              data-album-id={t.albumId}
            >
              <span class="track-idx">{idx + 1}</span>
              <img
                src={t.cover}
                alt={t.title}
                class="playlist-thumb"
                data-audio-url={t.audioUrl}
              />
              <div class="playlist-track-meta" data-action="play">
                <span class="playlist-track-name">{t.title}</span>
                <span class="playlist-track-artist">{t.artist}</span>
              </div>
              <span class="playlist-track-album" data-action="play">
                {t.album}
              </span>
              <span class="playlist-track-duration">
                {t.duration || "2:30"}
              </span>
              <button
                class="row-share-btn"
                data-share-id={t.id}
                title="Copiar enlace de canción"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="row-share-icon"
                >
                  <circle cx="18" cy="5" r="3" />
                  <circle cx="6" cy="12" r="3" />
                  <circle cx="18" cy="19" r="3" />
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                </svg>
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Shared Link Toast Notification -->
  <div id="toast-notify" class="toast-notify hidden">
    <span>¡Enlace copiado al portapapeles!</span>
  </div>
</Layout>

<script>
  import { AudioEngine } from "../lib/audio/AudioEngine";
  import {
    $currentTrack,
    $isPlaying,
    $currentTime,
    $duration,
    $volume,
    $queue,
    $isShuffle,
    $repeatMode,
    playTrack,
    setQueue,
    togglePlay,
    toggleShuffle,
    cycleRepeatMode,
    playNext,
    playPrevious,
    setVolume,
  } from "../lib/audio/PlayerStore";
  import { TRACKS } from "../data/tracks";
  import { extractAudioMetadata } from "../lib/audio/MetadataExtractor";
  import { withBase } from "../utils/base";

  let isPlaylistVisible = true;
  let isAnimating = false;
  let isMobileLyricsOverlayOpen = false;

  function updatePlayIconUI(playing: boolean) {
    const iconPlay = document.getElementById("icon-play-main");
    const iconPause = document.getElementById("icon-pause-main");
    if (playing) {
      iconPlay?.classList.add("hidden");
      iconPause?.classList.remove("hidden");
    } else {
      iconPlay?.classList.remove("hidden");
      iconPause?.classList.add("hidden");
    }
  }

  function updateShuffleIconUI(isShuffle: boolean) {
    const btnShuffle = document.getElementById("btn-shuffle");
    if (btnShuffle) {
      if (isShuffle) {
        btnShuffle.classList.add("active");
      } else {
        btnShuffle.classList.remove("active");
      }
    }
  }

  function updateRepeatIconUI(mode: string) {
    const btnRepeat = document.getElementById("btn-repeat");
    if (btnRepeat) {
      btnRepeat.classList.remove("active", "active-one");
      if (mode === "all") {
        btnRepeat.classList.add("active");
      } else if (mode === "one") {
        btnRepeat.classList.add("active", "active-one");
      }
    }
  }

  function initMainPlayer() {
    AudioEngine.init();

    // Ensure queue has full tracks catalog
    if ($queue.get().length !== TRACKS.length) {
      setQueue(TRACKS);
    }

    const playBtn = document.getElementById("btn-play-main");
    const btnNext = document.getElementById("btn-next-main");
    const btnPrev = document.getElementById("btn-prev-main");
    const btnShuffle = document.getElementById("btn-shuffle");
    const btnRepeat = document.getElementById("btn-repeat");

    const coverStage = document.getElementById("cover-stage");
    const btnTogglePlaylist = document.getElementById("btn-toggle-playlist");
    const toggleLabel = document.getElementById("toggle-playlist-label");
    const playlistContainer = document.getElementById("playlist-container");
    const volSlider = document.getElementById(
      "vol-range-main",
    ) as HTMLInputElement;
    const btnShareMain = document.getElementById("btn-share-main");

    const btnToggleLyricsOverlay = document.getElementById(
      "btn-toggle-lyrics-overlay",
    );
    const btnCloseLyricsOverlay = document.getElementById(
      "btn-close-lyrics-overlay",
    );
    const mobileLyricsOverlay = document.getElementById(
      "mobile-lyrics-overlay",
    );
    const sidebarSearch = document.getElementById(
      "sidebar-search-input",
    ) as HTMLInputElement;

    const title = document.getElementById("main-track-title");
    const artist = document.getElementById("main-artist-name");
    const category = document.getElementById("main-category-badge");
    const seekBar = document.getElementById("seek-bar");

    playBtn?.addEventListener("click", () => togglePlay());
    btnNext?.addEventListener("click", () => triggerNext3D());
    btnPrev?.addEventListener("click", () => triggerPrev3D());
    btnShuffle?.addEventListener("click", () => toggleShuffle());
    btnRepeat?.addEventListener("click", () => cycleRepeatMode());

    btnShareMain?.addEventListener("click", () => {
      const current = $currentTrack.get();
      if (current) copyTrackShareLink(current.id);
    });

    // Folder Filter Tabs Handler (all / folder names)
    const filterTabs = document.querySelectorAll("[data-filter-folder]");
    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        filterTabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const folder = tab.getAttribute("data-filter-folder");
        filterPlaylistRows(folder || "all", sidebarSearch?.value || "");
      });
    });

    if (sidebarSearch) {
      sidebarSearch.oninput = (e) => {
        const query = (e.target as HTMLInputElement).value;
        const activeTab = document.querySelector("[data-filter-folder].active");
        const folder = activeTab?.getAttribute("data-filter-folder") || "all";
        filterPlaylistRows(folder, query);
      };
    }

    btnToggleLyricsOverlay?.addEventListener("click", (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = !isMobileLyricsOverlayOpen;
      if (mobileLyricsOverlay) {
        if (isMobileLyricsOverlayOpen) {
          mobileLyricsOverlay.classList.add("active");
          setTimeout(
            () => window.dispatchEvent(new CustomEvent("realign-lrc")),
            100,
          );
        } else {
          mobileLyricsOverlay.classList.remove("active");
        }
      }
    });

    btnCloseLyricsOverlay?.addEventListener("click", (e) => {
      e.stopPropagation();
      isMobileLyricsOverlayOpen = false;
      if (mobileLyricsOverlay) mobileLyricsOverlay.classList.remove("active");
    });

    coverStage?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("#mobile-lyrics-overlay")) return;

      const card = (e.target as HTMLElement).closest(".cover-card");
      if (!card) return;
      const pos = card.getAttribute("data-pos");
      if (pos === "1") {
        triggerNext3D();
      } else if (pos === "-1") {
        triggerPrev3D();
      } else if (pos === "0") {
        togglePlay();
      }
    });

    btnTogglePlaylist?.addEventListener("click", () => {
      isPlaylistVisible = !isPlaylistVisible;
      if (playlistContainer) {
        if (isPlaylistVisible) {
          playlistContainer.classList.remove("collapsed");
          if (toggleLabel) toggleLabel.textContent = "Ocultar lista";
        } else {
          playlistContainer.classList.add("collapsed");
          if (toggleLabel) toggleLabel.textContent = "Mostrar lista";
        }
      }
    });

    volSlider?.addEventListener("input", (e) => {
      setVolume(parseFloat((e.target as HTMLInputElement).value));
    });

    seekBar?.addEventListener("click", (e) => {
      const rect = seekBar.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      const dur = $duration.get();
      if (dur > 0) {
        AudioEngine.seek(pct * dur);
      }
    });

    // Playlist row listeners
    const playlistRows = document.querySelectorAll(".playlist-track-row");
    playlistRows.forEach((row) => {
      row.addEventListener("click", (e) => {
        const shareBtn = (e.target as HTMLElement).closest("[data-share-id]");
        if (shareBtn) {
          e.stopPropagation();
          const shareId = shareBtn.getAttribute("data-share-id");
          if (shareId) copyTrackShareLink(shareId);
          return;
        }

        const id = row.getAttribute("data-track-id");
        const found = TRACKS.find((t) => t.id === id);
        if (found) {
          playTrack(found);
        }
      });
    });

    extractPlaylistID3Covers();

    // Initial sync of current track and button states
    updatePlayIconUI($isPlaying.get());
    updateShuffleIconUI($isShuffle.get());
    updateRepeatIconUI($repeatMode.get());

    const cur = $currentTrack.get();
    if (cur) {
      if (title) title.textContent = cur.title;
      if (artist) artist.textContent = cur.artist;
      if (category) category.textContent = cur.album.toUpperCase();
      update5CardCarouselStage(cur);
      highlightActivePlaylistItem(cur.id);
    }
  }

  // Subscribe to reactive stores
  $currentTrack.subscribe((track) => {
    if (track) {
      const title = document.getElementById("main-track-title");
      const artist = document.getElementById("main-artist-name");
      const category = document.getElementById("main-category-badge");
      if (title) title.textContent = track.title;
      if (artist) artist.textContent = track.artist;
      if (category) category.textContent = track.album.toUpperCase();

      update5CardCarouselStage(track);
      highlightActivePlaylistItem(track.id);
    }
  });

  $isPlaying.subscribe((playing) => {
    updatePlayIconUI(playing);
  });

  $isShuffle.subscribe((isShuffle: boolean) => {
    updateShuffleIconUI(isShuffle);
  });

  $repeatMode.subscribe((mode: string) => {
    updateRepeatIconUI(mode);
  });

  $currentTime.subscribe((time) => {
    const timeCurrent = document.getElementById("main-time-current");
    const seekFill = document.getElementById("seek-fill");
    if (timeCurrent) timeCurrent.textContent = formatTime(time);
    const dur = $duration.get();
    if (dur > 0 && seekFill) {
      seekFill.style.width = `${(time / dur) * 100}%`;
    }
  });

  $duration.subscribe((dur) => {
    const timeDuration = document.getElementById("main-time-duration");
    if (timeDuration) timeDuration.textContent = formatTime(dur);
  });

  $volume.subscribe((vol) => {
    const volSlider = document.getElementById(
      "vol-range-main",
    ) as HTMLInputElement;
    if (volSlider) volSlider.value = vol.toString();
  });

  function filterPlaylistRows(folder: string, searchQuery: string) {
    const rows = document.querySelectorAll(".playlist-track-row");
    const q = searchQuery.toLowerCase().trim();

    rows.forEach((row) => {
      const albumId = row.getAttribute("data-album-id");
      const trackName = (
        row.querySelector(".playlist-track-name")?.textContent || ""
      ).toLowerCase();
      const trackArtist = (
        row.querySelector(".playlist-track-artist")?.textContent || ""
      ).toLowerCase();

      const matchesFolder = folder === "all" || albumId === folder;
      const matchesSearch =
        !q || trackName.includes(q) || trackArtist.includes(q);

      if (matchesFolder && matchesSearch) {
        (row as HTMLElement).style.display = "grid";
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });
  }

  function triggerNext3D() {
    if (isAnimating) return;
    isAnimating = true;

    const cards = document.querySelectorAll(".cover-card");
    cards.forEach((card) => {
      let currentPos = parseInt(card.getAttribute("data-pos") || "0", 10);
      let newPos = currentPos - 1;
      if (newPos < -2) newPos = 2;
      card.setAttribute("data-pos", newPos.toString());
    });

    setTimeout(() => {
      playNext();
      isAnimating = false;
    }, 380);
  }

  function triggerPrev3D() {
    if (isAnimating) return;
    isAnimating = true;

    const cards = document.querySelectorAll(".cover-card");
    cards.forEach((card) => {
      let currentPos = parseInt(card.getAttribute("data-pos") || "0", 10);
      let newPos = currentPos + 1;
      if (newPos > 2) newPos = -2;
      card.setAttribute("data-pos", newPos.toString());
    });

    setTimeout(() => {
      playPrevious();
      isAnimating = false;
    }, 380);
  }

  function update5CardCarouselStage(currentTrack: any) {
    const queue = $queue.get();
    if (!queue || queue.length === 0) return;
    const currentIndex = queue.findIndex((t) => t.id === currentTrack.id);
    if (currentIndex === -1) return;

    const cards = document.querySelectorAll(".cover-card");

    cards.forEach((card) => {
      const pos = parseInt(card.getAttribute("data-pos") || "0", 10);
      const targetIndex =
        (currentIndex + pos + queue.length * 100) % queue.length;
      const targetTrack = queue[targetIndex];
      const img = card.querySelector("img") as HTMLImageElement;

      if (img && targetTrack) {
        if (img.src !== targetTrack.cover) {
          img.src = targetTrack.cover;
        }

        extractAudioMetadata(targetTrack.audioUrl).then((meta) => {
          if (meta.coverUrl) {
            targetTrack.cover = meta.coverUrl;
            const latestIndex = queue.findIndex(
              (t) => t.id === $currentTrack.get()?.id,
            );
            const latestPos = parseInt(
              card.getAttribute("data-pos") || "0",
              10,
            );
            const expectedIndex =
              (latestIndex + latestPos + queue.length * 100) % queue.length;
            if (expectedIndex === targetIndex) {
              img.src = meta.coverUrl;
            }
          }
        });
      }
    });
  }

  function highlightActivePlaylistItem(trackId: string) {
    const btns = document.querySelectorAll(".playlist-track-row");
    btns.forEach((btn) => {
      if (btn.getAttribute("data-track-id") === trackId) {
        btn.classList.add("active-track");
      } else {
        btn.classList.remove("active-track");
      }
    });
  }

  async function extractPlaylistID3Covers() {
    const thumbs = document.querySelectorAll(".playlist-thumb[data-audio-url]");
    thumbs.forEach(async (thumb) => {
      const audioUrl = thumb.getAttribute("data-audio-url");
      if (audioUrl) {
        const meta = await extractAudioMetadata(audioUrl);
        if (meta.coverUrl) {
          (thumb as HTMLImageElement).src = meta.coverUrl;
          const trackId = thumb
            .closest(".playlist-track-row")
            ?.getAttribute("data-track-id");
          const found = TRACKS.find((t) => t.id === trackId);
          if (found) found.cover = meta.coverUrl;
        }
      }
    });
  }

  async function copyTrackShareLink(trackId: string) {
    const shareUrl = `${window.location.origin}${withBase(`/track/${trackId}`)}`;
    try {
      if (navigator.share) {
        await navigator.share({
          title: "Racoon Music",
          text: "Escucha este tema en Racoon Music",
          url: shareUrl,
        });
      } else {
        await navigator.clipboard.writeText(shareUrl);
        showToast();
      }
    } catch (e) {
      await navigator.clipboard.writeText(shareUrl);
      showToast();
    }
  }

  function showToast() {
    const toast = document.getElementById("toast-notify");
    if (toast) {
      toast.classList.remove("hidden");
      toast.classList.add("show");
      setTimeout(() => {
        toast.classList.remove("show");
        toast.classList.add("hidden");
      }, 2500);
    }
  }

  function formatTime(sec: number): string {
    if (isNaN(sec) || sec <= 0) return "0:00";
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? "0" : ""}${s}`;
  }

  document.addEventListener("astro:page-load", () => initMainPlayer());
</script>

