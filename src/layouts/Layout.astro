---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/base';
import { ALBUMS } from '../data/tracks';
import PersistentBottomPlayer from '../components/PersistentBottomPlayer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  jsonLd?: object;
}

const {
  title = 'Racoon Music — Beats',
  description = 'Reproductor de beats con espectro en vivo y letras sincronizadas LRC.',
  image = withBase('/images/og-cover.png'),
  type = 'website',
  jsonLd
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={withBase('/rakunio_logo.jpeg')} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font & Asset Performance Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    {image && <link rel="preload" as="image" href={image} fetchpriority="high" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- OpenGraph Tags -->
    <meta property="og:site_name" content="Rakun.io" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />

    <!-- PWA & Offline Support -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#b56938" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <script is:inline define:vars={{ swUrl: withBase('/sw.js') }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl, { scope: './' })
            .then((reg) => {
              console.log('[SW] Registered successfully:', reg.scope);
              
              // Forzar comprobación de actualización en el servidor
              reg.update();

              // Detectar cuando se instala una nueva versión del Service Worker
              reg.addEventListener('updatefound', () => {
                const newWorker = reg.installing;
                if (!newWorker) return;
                newWorker.addEventListener('statechange', () => {
                  if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    console.log('[SW] Nueva versión detectada, recargando...');
                    window.location.reload();
                  }
                });
              });
            })
            .catch((err) => console.warn('[SW] Registration failed:', err));

          // Recargar automáticamente cuando el nuevo Service Worker tome el control
          let refreshing = false;
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (!refreshing) {
              refreshing = true;
              window.location.reload();
            }
          });
        });
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <!-- Mobile Top Header Bar (only visible on mobile <= 960px) -->
    <header class="mobile-top-bar glass-panel">
      <a href={withBase('/album/rakunio')} class="mobile-brand">
        <img src={withBase('/rakunio_logo.jpeg')} alt="Rakun.io" class="brand-logo-img" />
        <span class="brand-title">Rakun.io <small>music beats</small></span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Abrir menú de navegación">
        <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>
    </header>

    <!-- Backdrop Overlay for Mobile Drawer -->
    <div id="mobile-drawer-backdrop" class="mobile-drawer-backdrop"></div>

    <div class="app-shell">
      <!-- Left Sidebar Navigation / Mobile Drawer -->
      <aside id="sidebar-drawer" class="sidebar glass-panel">
        <div class="sidebar-header-mobile">
          <div class="sidebar-brand">
            <img src={withBase('/rakunio_logo.jpeg')} alt="Rakun.io" class="brand-logo-img" />
            <div class="brand-text-group">
              <span class="brand-title">Rakun.io</span>
              <span class="brand-sub">music beats</span>
            </div>
          </div>

          <button id="mobile-drawer-close" class="drawer-close-btn" aria-label="Cerrar menú">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="close-icon">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" id="sidebar-search-input" placeholder="Buscar beats..." class="search-input" />
        </div>

        <nav class="sidebar-nav">
          <span class="nav-section-title">Carpetas</span>
          {ALBUMS.map((album) => (
            <a href={withBase(`/album/${album.id}`)} class={`nav-link ${currentPath.includes(`/album/${album.id}`) ? 'active' : ''}`}>
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
              <span>{album.title}</span>
            </a>
          ))}
        </nav>

        <!-- Sección de instalación PWA usando el elemento HTML <install> y fallback JS -->
        <div class="sidebar-install-container">
          <span class="nav-section-title">Aplicación</span>
          
          <!-- Elemento nativo declarativo HTML <install> (Web Install API) -->
          <install id="native-html-install"></install>

          <!-- Botón de respaldo (fallback para navegadores que aún no ejecutan el elemento <install> nativo) -->
          <button id="pwa-fallback-install-btn" class="install-app-btn" style="display: none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="install-btn-icon">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Instalar App</span>
          </button>
        </div>
      </aside>

      <!-- Right Main Content Canvas -->
      <main class="main-viewport">
        <slot />
      </main>
    </div>

    <!-- Spotify-Style Persistent Bottom Player Bar -->
    <PersistentBottomPlayer transition:persist="global-bottom-player-bar" />

    <script>
      function initMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-drawer-close');
        const drawer = document.getElementById('sidebar-drawer');
        const backdrop = document.getElementById('mobile-drawer-backdrop');
        const navLinks = drawer?.querySelectorAll('.nav-link');

        function openMenu() {
          drawer?.classList.add('mobile-open');
          backdrop?.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          drawer?.classList.remove('mobile-open');
          backdrop?.classList.remove('active');
          document.body.style.overflow = '';
        }

        toggleBtn?.addEventListener('click', openMenu);
        closeBtn?.addEventListener('click', closeMenu);
        backdrop?.addEventListener('click', closeMenu);

        navLinks?.forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      }

      function initInstallButton() {
        const nativeInstall = document.getElementById('native-html-install');
        const fallbackBtn = document.getElementById('pwa-fallback-install-btn');
        let deferredPrompt: any = null;

        // Ocultar si la aplicación ya se ejecuta en modo standalone PWA
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
        if (isStandalone) {
          if (nativeInstall) nativeInstall.style.display = 'none';
          if (fallbackBtn) fallbackBtn.style.display = 'none';
          return;
        }

        // Detectar si el navegador soporta nativamente el elemento <install>
        const supportsNativeInstall = 'HTMLInstallElement' in window || (nativeInstall && !(nativeInstall instanceof HTMLUnknownElement));

        if (!supportsNativeInstall) {
          // Capturar el evento beforeinstallprompt para navegadores compatibles (Chrome/Edge/Android)
          window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            if (fallbackBtn) fallbackBtn.style.display = 'flex';
          });

          fallbackBtn?.addEventListener('click', async () => {
            // Probar navigator.install() si está disponible (Web Install API)
            if ('install' in navigator && typeof (navigator as any).install === 'function') {
              try {
                await (navigator as any).install();
                fallbackBtn.style.display = 'none';
                return;
              } catch (err) {
                console.warn('[WebInstall] Error al usar navigator.install:', err);
              }
            }

            if (deferredPrompt) {
              deferredPrompt.prompt();
              const { outcome } = await deferredPrompt.userChoice;
              if (outcome === 'accepted') {
                fallbackBtn.style.display = 'none';
              }
              deferredPrompt = null;
            }
          });
        }
      }

      document.addEventListener('astro:page-load', () => {
        initMobileMenu();
        initInstallButton();
      });
    </script>
  </body>
</html>

<style>
  .app-shell {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100vh;
    width: 100%;
    max-width: 1600px;
    padding: 16px;
    gap: 20px;
    margin: 0 auto;
    padding-bottom: 90px;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  .mobile-top-bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    width: calc(100% - 24px);
    margin: 12px auto 0 auto;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    position: sticky;
    top: 12px;
    z-index: 100;
    box-sizing: border-box;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-logo-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--glass-border-dark);
  }

  .mobile-brand .brand-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .mobile-brand .brand-title small {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .mobile-menu-btn {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--glass-border-dark);
    color: var(--text-main);
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .mobile-menu-btn:hover {
    background: white;
    transform: scale(1.05);
  }

  .hamburger-icon {
    width: 20px;
    height: 20px;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    height: fit-content;
    position: sticky;
    top: 16px;
  }

  .sidebar-header-mobile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .drawer-close-btn {
    display: none;
    background: rgba(0, 0, 0, 0.06);
    border: none;
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .drawer-close-btn:hover {
    background: rgba(0, 0, 0, 0.12);
    color: var(--text-main);
  }

  .close-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(31, 26, 23, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 28px;
    height: 28px;
    color: var(--accent-warm);
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text-main);
    line-height: 1;
  }

  .brand-sub {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-dim);
  }

  .search-input {
    width: 100%;
    padding: 10px 12px 10px 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border-dark);
    background: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    color: var(--text-main);
    transition: var(--transition-smooth);
  }

  .search-input:focus {
    outline: none;
    background: white;
    border-color: var(--accent-warm);
    box-shadow: 0 0 0 3px rgba(181, 105, 56, 0.12);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-section-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 4px;
    padding-left: 8px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition-smooth);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.7);
  }

  .nav-link.active {
    color: var(--accent-warm);
    background: white;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(181, 105, 56, 0.08);
  }

  .nav-icon {
    width: 18px;
    height: 18px;
  }

  .sidebar-install-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--glass-border-dark);
  }

  /* Estilos para el elemento nativo declarativo HTML <install> */
  install {
    display: block;
    width: 100%;
    border-radius: var(--radius-md);
  }

  .install-app-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--accent-warm);
    color: white;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 12px rgba(181, 105, 56, 0.2);
  }

  .install-app-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(181, 105, 56, 0.3);
  }

  .install-btn-icon {
    width: 18px;
    height: 18px;
  }

  .main-viewport {
    width: 100%;
    overflow-x: hidden;
  }

  @media (max-width: 960px) {
    .mobile-top-bar {
      display: flex;
    }

    .mobile-drawer-backdrop {
      display: block;
    }

    .drawer-close-btn {
      display: flex;
    }

    .app-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: 12px;
      gap: 12px;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: 280px;
      height: 100vh;
      max-height: 100vh;
      z-index: 1000;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
      overflow-y: auto;
    }

    .sidebar.mobile-open {
      transform: translateX(0);
    }
  }
</style>
