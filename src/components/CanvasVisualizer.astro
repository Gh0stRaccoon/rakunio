---
---

<div class="visualizer-container">
  <canvas id="audio-visualizer-canvas" class="visualizer-canvas"></canvas>
</div>

<script>
  import { AudioEngine } from '../lib/audio/AudioEngine';
  import { $isPlaying, $currentTrack } from '../lib/audio/PlayerStore';

  let animationFrameId: number | null = null;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;

  const NUM_BARS = 54;
  const barHeights = new Float32Array(NUM_BARS).fill(6);
  let frequencyData = new Uint8Array(256);

  function initCanvas() {
    canvas = document.getElementById('audio-visualizer-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    ctx = canvas.getContext('2d');
    if (!ctx) return;

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
    }
    renderLoop();
  }

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    
    // Set actual render resolution matching device pixel ratio
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;

    if (ctx) {
      ctx.scale(dpr, dpr);
    }
  }

  function renderLoop() {
    animationFrameId = requestAnimationFrame(renderLoop);

    if (!canvas || !ctx) return;
    const width = canvas.width / (window.devicePixelRatio || 1);
    const height = canvas.height / (window.devicePixelRatio || 1);

    ctx.clearRect(0, 0, width, height);

    const analyser = AudioEngine.getAnalyser();
    const isPlaying = $isPlaying.get();
    const currentTrack = $currentTrack.get();
    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
    const isHome = currentPath === '/' || currentPath.endsWith('/rakunio');

    let isTrackPlayingOnThisPage = false;
    if (currentTrack && isPlaying) {
      if (isHome) {
        isTrackPlayingOnThisPage = currentTrack.albumId === 'rakunio';
      } else {
        isTrackPlayingOnThisPage = currentPath.includes(`/album/${currentTrack.albumId}`) || currentPath.includes(`/track/${currentTrack.id}`);
      }
    }

    if (!analyser || !isPlaying || !isTrackPlayingOnThisPage) {
      drawIdleState(ctx, width, height);
      return;
    }

    const bufferLength = analyser.frequencyBinCount;
    if (frequencyData.length !== bufferLength) {
      frequencyData = new Uint8Array(bufferLength);
    }

    analyser.getByteFrequencyData(frequencyData as any);
    drawSpectrumBars(ctx, width, height, frequencyData);
  }

  function drawIdleState(ctx: CanvasRenderingContext2D, width: number, height: number) {
    const numBars = NUM_BARS;
    const barWidth = 4;
    const gap = (width - numBars * barWidth) / (numBars - 1);
    const midY = height / 2;

    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';

    for (let i = 0; i < numBars; i++) {
      const currentBarH = barHeights[i] ?? 6;
      const nextBarH = currentBarH + (6 - currentBarH) * 0.35;
      barHeights[i] = nextBarH;
      const x = i * (barWidth + gap);
      const h = nextBarH + Math.sin(i * 0.3) * 2;
      ctx.beginPath();
      ctx.roundRect(x, midY - h / 2, barWidth, h, 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawSpectrumBars(ctx: CanvasRenderingContext2D, width: number, height: number, data: Uint8Array) {
    const numBars = NUM_BARS;
    const barWidth = 4;
    const gap = (width - numBars * barWidth) / (numBars - 1);
    const minSampleIndex = 2; // Skip static DC sub-rumble (<40Hz)
    const maxIndex = Math.floor(data.length * 0.75);
    const midY = height / 2;

    const LOG_COMPRESSION_K = 3.5;
    const LOG_DENOMINATOR = Math.log10(1 + LOG_COMPRESSION_K);

    // Radiant glowing gradient for bars over cover art
    const gradient = ctx.createLinearGradient(0, 0, width, 0);
    gradient.addColorStop(0, '#ffffff');
    gradient.addColorStop(0.35, '#ffcca7');
    gradient.addColorStop(0.7, '#f4efe8');
    gradient.addColorStop(1, '#ffffff');

    ctx.save();
    ctx.fillStyle = gradient;
    ctx.shadowColor = 'rgba(255, 204, 167, 0.7)';
    ctx.shadowBlur = 10;

    for (let i = 0; i < numBars; i++) {
      const normalizedPos = i / numBars; // 0.0 (bass) to 1.0 (treble)

      // Frequency Logarithmic Mapping across spectrum
      const sampleIndex = minSampleIndex + Math.floor(Math.pow(normalizedPos, 1.15) * (maxIndex - minSampleIndex));
      const rawValue = data[sampleIndex] || 0;

      let normalizedRaw = rawValue / 255;

      // Dynamic Bass Kick Response Tuning
      if (normalizedPos < 0.28) {
        const bassEq = 0.52 + normalizedPos * 0.8;
        normalizedRaw = Math.pow(Math.min(1.0, normalizedRaw * bassEq), 1.35);
      } else {
        const eqFactor = 0.70 + ((normalizedPos - 0.28) * 0.75);
        normalizedRaw = Math.min(1.0, normalizedRaw * eqFactor);
      }

      // Logarithmic / dB Reaction Curve
      const logPercent = normalizedRaw > 0 
        ? Math.log10(1 + LOG_COMPRESSION_K * normalizedRaw) / LOG_DENOMINATOR 
        : 0;

      const targetBarHeight = Math.max(6, logPercent * (height - 6));

      // Ultra-fast dual-speed lerp for instant kick drum bounce
      const currentBarH = barHeights[i] ?? 6;
      const lerpSpeed = targetBarHeight > currentBarH ? 0.85 : 0.75;
      const nextBarH = currentBarH + (targetBarHeight - currentBarH) * lerpSpeed;
      barHeights[i] = nextBarH;

      const x = i * (barWidth + gap);
      const y = midY - nextBarH / 2;

      ctx.beginPath();
      ctx.roundRect(x, y, barWidth, nextBarH, 2);
      ctx.fill();
    }

    ctx.restore();
  }

  document.addEventListener('astro:page-load', () => initCanvas());
</script>

<style>
  .visualizer-container {
    position: relative;
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visualizer-canvas {
    width: 270px;
    height: 100%;
    display: block;
    mix-blend-mode: plus-lighter;
  }
</style>
